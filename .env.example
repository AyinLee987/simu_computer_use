# Model source: auto first detects an already logged-in local Codex CLI,
# even when OPENAI_API_KEY is filled. If no Codex login is detected, use API.
# Choices: auto / openai / codex. Explicit openai/codex always keep that source.
# A usable Codex CLI must access a local login under the same OS user.
# Windows also tries the CLI bundled with the Codex desktop application.
# The selected source stays fixed until an idle login recheck or a server restart.
# Requests never switch source automatically while running or after a failure.
# Login recheck does not reload .env. Restart the Node server after editing it.
MODEL_PROVIDER=auto

# Fill your API key here; never put an OpenAI email/password in this file.
# This example has no secret. Your actual .env stays local and is git-ignored.
# Set MODEL_PROVIDER=openai to force API even when Codex is already logged in.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

# OpenAI: responses. Some compatible providers need chat_completions instead.
OPENAI_API_STYLE=responses
# Prefer json_schema. Use json_object only if your provider lacks schema support.
# The chosen model must support image input and JSON output in either mode.
OPENAI_RESPONSE_FORMAT=json_schema
OPENAI_TIMEOUT_MS=150000

# Optional Codex model override; blank keeps the CLI default.
# Codex ChatGPT login uses the corresponding Codex allowance; CLI API-key
# login still uses API billing. The UI displays the detected login method.
CODEX_MODEL=
# Optional full path if automatic CLI discovery cannot find your installation.
CODEX_EXECUTABLE=
PORT=4317

# API keys + desktop screenshots go to the configured API provider.
# Use HTTPS and a trusted provider. Do not share .env or dockercompose.env.
