# Model source: auto = use API when a key exists, otherwise reuse Codex login.
# Choices: auto / openai / codex. Restart the Node server after editing .env.
MODEL_PROVIDER=auto

# Fill your API key here; never put an OpenAI email/password in this file.
# This example has no secret. Your actual .env stays local and is git-ignored.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

# OpenAI: responses. Some compatible providers need chat_completions instead.
OPENAI_API_STYLE=responses
# Prefer json_schema. Use json_object only if your provider lacks schema support.
# The chosen model must support image input and JSON output in either mode.
OPENAI_RESPONSE_FORMAT=json_schema
OPENAI_TIMEOUT_MS=150000

# Optional Codex model override; blank keeps the CLI default.
CODEX_MODEL=
PORT=4317

# API keys + desktop screenshots go to the configured API provider.
# Use HTTPS and a trusted provider. Do not share .env or dockercompose.env.
